---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import { getDict, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** 현재 페이지의 언어별 주소 (언어 전환 버튼과 hreflang 에 사용) */
  paths: Record<Lang, string>;
  /** 홈(한국어)에서만 저장된 언어 선택에 따라 /en/ 으로 이동 */
  homeRedirect?: boolean;
  /** 홈 화면의 스크롤 연동 메뉴 강조 여부 */
  isHome?: boolean;
  image?: string;
}
const { lang, title, description, paths, homeRedirect = false, isHome = false, image } = Astro.props;
const t = getDict(lang);
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const site = Astro.site ?? new URL('https://portfolio.kashic.dev');
const canonical = new URL(paths[lang], site).href;
const pageTitle = title ? `${title} | Kinesis` : t.meta.title;
const pageDesc = description ?? t.meta.description;
const ogImage = new URL(image ?? '/og.png', site).href; // 이미지가 없으면 기본 미리보기(public/og.png)
const home = localePath(lang, '/');
const links = [
  ['home', `${home}#top`],
  ['profile', `${home}#profile`],
  ['projects', `${home}#projects`],
  ['experience', `${home}#experience`],
  ['activity', `${home}#activity`],
  ['journal', `${home}#journal`],
] as const;
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ko" href={new URL(paths.ko, site).href} />
    <link rel="alternate" hreflang="en" href={new URL(paths.en, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(paths.ko, site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:site_name" content="Kinesis" />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0a0a0b" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {homeRedirect && (
      <script is:inline>
        try {
          if (localStorage.getItem('lang') === 'en' && location.pathname === '/') {
            location.replace('/en/' + location.search + location.hash);
          }
        } catch (e) {}
      </script>
    )}
  </head>
  <body data-home={isHome ? '1' : '0'}>
    <nav class="site-nav">
      <div class="wrap">
        <a class="logo" href={`${home}#top`} aria-label="Kinesis">KINES<i>I</i>S</a>
        <div class="l">
          {links.map(([k, href]) => <a href={href} data-nav={k}>{t.nav[k]}</a>)}
        </div>
        <a class="lang-switch" href={paths[other]} data-lang-switch={other} hreflang={other} aria-label={t.nav.langSwitchLabel}>{t.nav.langSwitch}</a>
        <a class="btn" href={`${home}#contact`}>{t.nav.contact}</a>
      </div>
    </nav>
    <slot />
    <footer class="site-footer">{t.footer.replace('{year}', String(new Date().getFullYear()))}</footer>
    <script>
      import '../scripts/reveal';
    </script>
    <script is:inline>
      document.querySelectorAll('[data-lang-switch]').forEach(function (a) {
        a.addEventListener('click', function () {
          try { localStorage.setItem('lang', a.getAttribute('data-lang-switch')); } catch (e) {}
        });
      });
    </script>
  </body>
</html>
